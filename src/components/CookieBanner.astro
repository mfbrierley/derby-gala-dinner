---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!--
  Cookie banner. The only thing on the site that sets non-essential cookies is the
  live Google map (event details page), so the map only loads after "Accept".
  Copy is not from the Figma and is listed in PLACEHOLDERS.md for approval.
-->
<section class="cookie-banner" aria-labelledby="cookie-banner-title" data-cookie-banner hidden>
  <p class="label gold cookie-banner__title" id="cookie-banner-title">Cookies</p>
  <p class="cookie-banner__text">
    We only use cookies to show the live Google map on our event details page. Accept to load the map, or reject and we
    won't load it. You can change your mind at any time with Cookie settings at the bottom of every page.{' '}
    <a href={`${base}/privacy-policy/#cookies`}>Read more about cookies</a>
  </p>
  <div class="cookie-banner__actions">
    <button type="button" class="btn btn--gold" data-consent="accepted">Accept</button>
    <button type="button" class="btn btn--cream" data-consent="rejected">Reject</button>
  </div>
</section>

<style>
  .cookie-banner {
    position: fixed;
    left: max(16px, calc(40 * var(--u)));
    bottom: max(16px, calc(40 * var(--u)));
    z-index: 80;
    width: min(calc(100% - 32px), 540px);
    padding: 28px 28px 24px;
    border: 2px solid var(--gold);
    border-radius: 20px;
    background: var(--black);
    color: var(--white);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }

  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-banner__text {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.45;
  }

  .cookie-banner__text a {
    color: var(--gold);
    text-underline-offset: 3px;
  }

  .cookie-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }

  .cookie-banner__actions .btn {
    width: auto;
    min-width: 140px;
    height: 48px;
    font-size: calc(18px * var(--type-scale));
  }

  @media (max-width: 899px) {
    .cookie-banner {
      left: 12px;
      right: 12px;
      bottom: 12px;
      width: auto;
      padding: 22px 20px 20px;
    }

    .cookie-banner__actions .btn {
      flex: 1;
      min-width: 0;
    }
  }
</style>

<script>
  import { getConsent, setConsent, CONSENT_EVENT } from '../scripts/consent';

  const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');

  if (banner) {
    const show = () => {
      banner.hidden = false;
    };

    if (!getConsent()) show();

    // A choice made somewhere else (e.g. "Accept cookies and show map") also closes the banner.
    document.addEventListener(CONSENT_EVENT, () => {
      banner.hidden = true;
    });

    banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((button) => {
      button.addEventListener('click', () => {
        setConsent(button.dataset.consent === 'accepted' ? 'accepted' : 'rejected');
        banner.hidden = true;
      });
    });

    document.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('[data-cookie-settings]')) {
        show();
        banner.querySelector<HTMLButtonElement>('[data-consent]')?.focus();
      }
    });
  }
</script>
