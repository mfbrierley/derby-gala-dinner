---
import logo from '../assets/svg/logo-dgd.svg?url';
import fundraisingFor from '../assets/svg/fundraising-for-footer.svg?url';
import btgLogo from '../assets/images/btg-logo.png';
import { BTG_URL } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
---

<footer class="site-footer bg-stripes">
  <div class="site-footer__inner">
    <a class="site-footer__logo" href={href('/')}>
      <img src={logo} width="163" height="99" alt="Derby Gala Dinner" />
    </a>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        <li><a href={href('/book-a-table/')}><strong>BOOK A TABLE</strong></a></li>
        <li><a href={href('/book-a-table/#sponsorship')}>SPONSOR EVENT</a></li>
        <li><a href={href('/event-details/')}>EVENT DETAILS</a></li>
        <li><a href={href('/your-hosts/')}>YOUR HOSTS</a></li>
        <li><a href={href('/gallery/')}>2026 GALLERY</a></li>
        <li><a href="#contact" data-open-contact>CONTACT</a></li>
      </ul>
    </nav>

    <a class="fundraising site-footer__fundraising" href={BTG_URL} target="_blank" rel="noopener">
      <img class="fundraising__text" src={fundraisingFor} width="307" height="15" alt="Fundraising for" />
      <img class="fundraising__logo" src={btgLogo.src} width="81" height="81" alt="Bridge the Gap" />
    </a>
  </div>

  <!-- Not in the Figma: legal links needed for the privacy policy and cookie choices. -->
  <ul class="site-footer__legal">
    <li><a href={href('/privacy-policy/')}>Privacy policy</a></li>
    <li><button type="button" data-cookie-settings>Cookie settings</button></li>
  </ul>
</footer>

<style>
  .site-footer {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(329 * var(--u));
    padding: calc(40 * var(--u)) 0;
    /* Figma crops the stripes image to its bottom edge, scaled to 194.83% of the footer box. */
    background-size: 194.83% 194.83%;
    background-position: 42% 100%;
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    padding: 0 calc(101 * var(--u) + var(--edge)) 0 calc(128 * var(--u) + var(--edge));
  }

  .site-footer__logo img {
    width: max(96px, calc(163 * var(--u)));
    height: auto;
  }

  .site-footer__nav {
    margin-left: calc(87 * var(--u));
  }

  .site-footer__nav a {
    display: block;
    font-size: var(--text-nav);
    line-height: 1.2;
    text-decoration: none;
    color: var(--white);
  }

  .site-footer__nav a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-footer__nav strong {
    font-weight: 700;
  }

  .fundraising {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .site-footer__fundraising {
    gap: calc(24 * var(--u));
    margin-left: auto;
  }

  .site-footer__fundraising .fundraising__text {
    width: calc(307 * var(--u));
    min-width: 160px;
    height: auto;
  }

  .site-footer__fundraising .fundraising__logo {
    width: calc(81 * var(--u));
    min-width: 48px;
    height: auto;
  }

  .site-footer__legal {
    position: absolute;
    right: calc(101 * var(--u) + var(--edge));
    bottom: max(14px, calc(24 * var(--u)));
    display: flex;
    gap: 20px;
    font-size: 13px;
  }

  .site-footer__legal a,
  .site-footer__legal button {
    padding: 0;
    border: 0;
    background: none;
    color: rgba(255, 255, 255, 0.72);
    font-size: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .site-footer__legal a:hover,
  .site-footer__legal button:hover {
    color: var(--white);
  }

  @media (max-width: 899px) {
    .site-footer {
      padding: 48px var(--gutter) 28px;
      background-size: cover;
      background-position: center bottom;
    }

    .site-footer__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
      padding: 0;
    }

    .site-footer__nav {
      margin-left: 0;
    }

    .site-footer__nav a {
      font-size: 15px;
      line-height: 1.8;
    }

    .site-footer__fundraising {
      margin-left: 0;
      gap: 14px;
    }

    .site-footer__legal {
      position: static;
      margin-top: 32px;
    }
  }
</style>
