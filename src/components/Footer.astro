---
import logo from '../assets/svg/logo-dgd.svg?url';
import fundraisingFor from '../assets/svg/fundraising-for.svg?url';
import btgLogo from '../assets/images/btg-logo.png';
import ProductionCredit from './ProductionCredit.astro';
import { BTG_URL } from '../config';
import { HEADLINE_SPONSOR, SUPPORTING_SPONSORS } from '../data/sponsors';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
---

<footer class="site-footer">
  <div class="site-footer__main bg-stripes">
    <div class="site-footer__top">
      <a class="site-footer__logo" href={href('/')}>
        <img src={logo} width="163" height="99" alt="Derby Gala Dinner" />
      </a>

      <nav class="site-footer__nav" aria-label="Footer">
        <ul>
          <li><a href={href('/book-a-table/')}><strong>BOOK A TABLE</strong></a></li>
          <li><a href={href('/book-a-table/#sponsorship')}>SPONSOR EVENT</a></li>
          <li><a href={href('/event-details/')}>EVENT DETAILS</a></li>
          <li><a href={href('/your-hosts/')}>YOUR HOSTS</a></li>
          <li><a href={href('/gallery/')}>2026 GALLERY</a></li>
          <li><a href="#contact" data-open-contact>CONTACT</a></li>
        </ul>
      </nav>

      <span class="site-footer__divider" aria-hidden="true"></span>

      <a class="site-footer__fundraising" href={BTG_URL} target="_blank" rel="noopener">
        <img class="site-footer__fundraising-text" src={fundraisingFor} width="267" height="13" alt="Fundraising for" />
        <img class="site-footer__fundraising-logo" src={btgLogo.src} width="70" height="69" alt="Bridge the Gap" />
      </a>
    </div>

    <div class="site-footer__sponsors">
      <p class="sponsor-rule sponsor-rule--gold"><span>Headline sponsor</span></p>
      <img
        class="site-footer__headline-logo"
        src={HEADLINE_SPONSOR.logo}
        width={HEADLINE_SPONSOR.width}
        height={HEADLINE_SPONSOR.height}
        alt={HEADLINE_SPONSOR.name}
        loading="lazy"
      />

      <p class="sponsor-rule sponsor-rule--white"><span>Supporting sponsors</span></p>
      <ul class="site-footer__supporting">
        {
          SUPPORTING_SPONSORS.map((sponsor) => (
            <li>
              <img
                src={sponsor.logo}
                width={sponsor.width}
                height={sponsor.height}
                alt={sponsor.name}
                loading="lazy"
                style={`--w: ${sponsor.footerWidth}`}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="site-footer__bar">
    <ProductionCredit />
    <!-- Not in the Figma: legal links needed for the privacy policy and cookie choices. -->
    <ul class="site-footer__legal">
      <li><a href={href('/privacy-policy/')}>Privacy policy</a></li>
      <li><button type="button" data-cookie-settings>Cookie settings</button></li>
    </ul>
  </div>
</footer>

<style>
  /*
   * Figma ("dgd - matt", home frame): logo, nav, a gold divider and "Fundraising for Bridge the
   * Gap" along the top; then the headline sponsor and the supporting sponsors, each under a
   * label between fine lines; then a 51px black bar with "A Volt7 production".
   * The Figma leaves a large gap under the supporting sponsors for sponsors still to come;
   * here the space below them matches the space at the top.
   */
  .site-footer__main {
    padding: calc(69 * var(--u)) calc(166 * var(--u) + var(--edge)) calc(84 * var(--u)) calc(128 * var(--u) + var(--edge));
    /*
     * As in the Figma: the stripes image zoomed in (232% of the page width, its own proportions,
     * not stretched) and pinned to the bottom edge, so the glowing ends of the stripes show.
     */
    background-size: 232% auto;
    background-position: 42.8% 100%;
  }

  /* ---------- Top row ---------- */

  .site-footer__top {
    display: flex;
    align-items: center;
  }

  .site-footer__logo img {
    width: max(96px, calc(163 * var(--u)));
    height: auto;
  }

  .site-footer__nav {
    margin-left: calc(87 * var(--u));
  }

  .site-footer__nav a {
    display: block;
    font-size: var(--text-nav);
    line-height: 1.2;
    text-decoration: none;
    color: var(--white);
  }

  .site-footer__nav a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-footer__nav strong {
    font-weight: 700;
  }

  .site-footer__divider {
    align-self: stretch;
    width: max(1px, calc(2 * var(--u)));
    min-height: calc(121 * var(--u));
    margin-left: calc(90 * var(--u));
    background: var(--gold);
  }

  .site-footer__fundraising {
    display: flex;
    align-items: center;
    gap: calc(21 * var(--u));
    align-self: flex-start;
    margin-top: calc(15 * var(--u));
    margin-left: auto;
  }

  .site-footer__fundraising-text {
    width: max(170px, calc(267 * var(--u)));
    height: auto;
  }

  .site-footer__fundraising-logo {
    width: max(44px, calc(70 * var(--u)));
    height: auto;
  }

  /* ---------- Sponsors ---------- */

  .site-footer__sponsors {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: calc(76 * var(--u));
  }

  .site-footer__sponsors .sponsor-rule {
    gap: 0;
    font-size: max(11px, calc(18 * var(--u) * var(--type-scale)));
  }

  /* Both labels sit in the same width, so the lines either side line up, as in the Figma. */
  .site-footer__sponsors .sponsor-rule span {
    min-width: calc(390 * var(--u));
    margin-right: 0;
    padding: 0 calc(20 * var(--u)) 0 calc(20 * var(--u) + 0.4em);
    text-align: center;
  }

  .site-footer__headline-logo {
    width: max(160px, calc(321 * var(--u)));
    height: auto;
    margin: calc(51 * var(--u)) 0 calc(75 * var(--u));
  }

  .site-footer__supporting {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: calc(30 * var(--u)) calc(64 * var(--u));
    margin-top: calc(43 * var(--u));
  }

  .site-footer__supporting img {
    width: calc(var(--w) * var(--u));
    height: auto;
  }

  /* ---------- Black bar ---------- */

  .site-footer__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: max(40px, calc(51 * var(--u)));
    padding: 0 calc(101 * var(--u) + var(--edge)) 0 calc(128 * var(--u) + var(--edge));
    background: #000;
    font-size: max(12px, calc(20 * var(--u) * var(--type-scale)));
  }

  .site-footer__legal {
    position: absolute;
    right: calc(101 * var(--u) + var(--edge));
    top: 50%;
    display: flex;
    gap: 20px;
    font-size: 13px;
    transform: translateY(-50%);
  }

  .site-footer__legal a,
  .site-footer__legal button {
    padding: 0;
    border: 0;
    background: none;
    color: rgba(255, 255, 255, 0.72);
    font-size: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .site-footer__legal a:hover,
  .site-footer__legal button:hover {
    color: var(--white);
  }

  /* Narrower desktops: the credit and legal links would collide, so the links drop below. */
  @media (min-width: 900px) and (max-width: 1279px) {
    .site-footer__bar {
      flex-direction: column;
      gap: 10px;
      padding-top: 14px;
      padding-bottom: 14px;
    }

    .site-footer__legal {
      position: static;
      transform: none;
    }
  }

  /* ---------- Phones ---------- */

  @media (max-width: 899px) {
    .site-footer__main {
      padding: 48px var(--gutter) 44px;
      /* Phones: the footer is tall and narrow, so scale the image to its height instead (still not stretched). */
      background-size: auto 100%;
      background-position: 42.8% 100%;
    }

    .site-footer__top {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
    }

    .site-footer__nav {
      margin-left: 0;
    }

    .site-footer__nav a {
      font-size: 15px;
      line-height: 1.8;
    }

    .site-footer__divider {
      display: none;
    }

    .site-footer__fundraising {
      gap: 14px;
      margin: 0;
    }

    .site-footer__fundraising-text {
      width: 190px;
    }

    .site-footer__fundraising-logo {
      width: 52px;
    }

    .site-footer__sponsors {
      margin-top: 44px;
    }

    .site-footer__sponsors .sponsor-rule {
      font-size: 11px;
    }

    .site-footer__sponsors .sponsor-rule span {
      min-width: 0;
      padding: 0 0 0 0.3em;
    }

    .site-footer__headline-logo {
      width: 180px;
      margin: 24px 0 36px;
    }

    .site-footer__supporting {
      gap: 20px 36px;
      margin-top: 24px;
    }

    .site-footer__supporting img {
      width: calc(var(--w) * 0.55px);
    }

    .site-footer__bar {
      flex-direction: column;
      gap: 12px;
      padding: 16px var(--gutter);
      font-size: 13px;
    }

    .site-footer__legal {
      position: static;
      transform: none;
    }
  }
</style>
