---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ENQUIRY_ENDPOINT, TURNSTILE_SITEKEY } from '../config';
import tableEvening from '../assets/images/table-evening.jpg';
import tableVip from '../assets/images/table-vip.jpg';
import sponsorHeadline from '../assets/images/sponsor-headline.jpg';
import sponsorSupporting from '../assets/images/sponsor-supporting.jpg';
import sponsorDrinks from '../assets/images/sponsor-drinks.jpg';
import sponsorLounge from '../assets/images/sponsor-lounge.jpg';
import sponsorOther from '../assets/images/sponsor-other.jpg';

interface Props {
  /**
   * `booking`: Reserve a table (opened by the Book a table buttons, data-open-booking).
   * `sponsorship`: Sponsorship enquiry (opened by Secure your sponsorship now, data-open-sponsorship).
   * `contact`: general enquiries (opened by CONTACT, data-open-contact).
   */
  variant: 'booking' | 'sponsorship' | 'contact';
}

const { variant } = Astro.props;
const id = `${variant}-modal`;
const endpoint = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${ENQUIRY_ENDPOINT}`;

// Booking and sponsorship copy supplied by Matt. The contact form copy is adapted from the Figma.
// (The email subject lines are set where the email is sent: public/api/enquiry.php.)
const copy = {
  booking: {
    eyebrow: '',
    title: 'Reserve a table.',
    intro: ['Please complete the form below to reserve your table. A member of our team will contact you within 24hrs to confirm.'],
  },
  sponsorship: {
    eyebrow: '',
    title: 'Sponsorship enquiry.',
    intro: [
      'Thank you for your interest in sponsoring the 2027 edition of the Derby Gala Dinner, it’s thanks to our sponsors that the event is able to make such an impact.',
      'Please complete the form below and one of the sponsorship team will reach out to you to discuss available options.',
    ],
  },
  contact: {
    eyebrow: 'Enquiry Form',
    title: 'get in touch. get involved.',
    intro: ['Please complete the form below and a member of our team will contact you within 24hrs.'],
  },
}[variant];

/**
 * Picture buttons for the table type (pick one) and sponsorship type (pick any), from the form
 * mockups in the "dgd - matt" Figma. `value` is what's emailed and what the opening button
 * pre-selects (data-open-booking / data-open-sponsorship); the same values are listed in
 * public/api/enquiry.php, which refuses any other. `position` is the photo crop from the Figma.
 */
type Pick = { value: string; label: string; image: ImageMetadata; position?: string; wide?: boolean; price?: string };

// `price` is shown under the name; keep it the same as on the Book a table page.
const tableTypes: Pick[] = [
  { value: 'Evening Table', label: 'Evening table', image: tableEvening, price: '£2,500 + VAT' },
  { value: 'VIP Table', label: 'VIP table', image: tableVip, price: '£3,500 + VAT' },
];
const sponsorshipTypes: Pick[] = [
  { value: 'Headline', label: 'Headline sponsor', image: sponsorHeadline, position: '50% 22%' },
  { value: 'Supporting', label: 'Supporting sponsor', image: sponsorSupporting },
  { value: 'Welcome drinks', label: 'Welcome drink sponsor', image: sponsorDrinks, position: '56% 50%' },
  { value: 'VIP lounge', label: 'VIP lounge sponsor', image: sponsorLounge, position: '74% 56%' },
  // Not in the form mockup, but on the Book a table page and in Matt's list of options.
  { value: 'Other', label: 'Other sponsorship', image: sponsorOther, wide: true },
];
const titles = ['Mr', 'Mrs', 'Ms', 'Miss', 'Mx', 'Dr'];
---

<dialog class="modal" id={id} aria-labelledby={`${id}-title`} aria-modal="true" data-variant={variant}>
  <div class="modal__panel">
    <button class="modal__x" type="button" data-close aria-label="Close">X</button>

    <div class="modal__view" data-view="form">
      {copy.eyebrow && <p class="label gold">{copy.eyebrow}</p>}
      <h2 class:list={['display display--md modal__title', { 'modal__title--first': !copy.eyebrow }]} id={`${id}-title`}>{copy.title}</h2>
      {copy.intro.map((text) => <p class="modal__intro">{text}</p>)}

      <!-- Field names here must match the FORMS list in public/api/enquiry.php, which sends the email. -->
      <form class="enquiry" action={endpoint} method="POST" novalidate data-turnstile-sitekey={TURNSTILE_SITEKEY}>
        <input type="hidden" name="form" value={variant} />
        <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" style="display: none" />

        {
          variant === 'booking' && (
            <>
              <div class="enquiry__row enquiry__row--2">
                <label class="field">
                  <input name="name" type="text" placeholder=" " autocomplete="name" required />
                  <span class="field__label">Your Name</span>
                </label>
                <label class="field">
                  <input name="email" type="email" placeholder=" " autocomplete="email" required />
                  <span class="field__label">Your email</span>
                </label>
              </div>
              <div class="enquiry__row enquiry__row--2">
                <label class="field">
                  <input name="company" type="text" placeholder=" " autocomplete="organization" />
                  <span class="field__label">Your Company name</span>
                </label>
                <label class="field">
                  <input name="phone" type="tel" placeholder=" " autocomplete="tel" />
                  <span class="field__label">Your contact number</span>
                </label>
              </div>
              <label class="field">
                <input name="address" type="text" placeholder=" " autocomplete="street-address" />
                <span class="field__label">Company Address</span>
              </label>
              <fieldset class="picks picks--tables" data-required-group data-required-message="Please choose a table type.">
                <legend class="picks__legend">Table type</legend>
                <div class="picks__grid">
                  {
                    tableTypes.map((t) => (
                      <label class="pick">
                        <input type="radio" name="table_type" value={t.value} />
                        <Image
                          src={t.image}
                          alt=""
                          widths={[480, 960]}
                          sizes="(max-width: 899px) 45vw, 440px"
                          loading="lazy"
                          style={t.position ? `object-position: ${t.position}` : undefined}
                        />
                        <span class="pick__label display">
                          {t.label}
                          {t.price && <span class="pick__price">{t.price}</span>}
                        </span>
                        <span class="pick__tick" aria-hidden="true" />
                      </label>
                    ))
                  }
                </div>
              </fieldset>
              <p class="enquiry__terms">
                Thank you for your interest in purchasing a table, all bookings are managed via an invoice system with full payment required to secure a booking, a booking is only confirmed upon successful receipt of payment.
                <br />
                Evening details such as menu choices and dietary requirements will be managed closer to the date of the event. By clicking submit you confirm your agreement to these terms.
              </p>
            </>
          )
        }

        {
          variant === 'sponsorship' && (
            <>
              <div class="enquiry__row enquiry__row--2">
                <label class="field">
                  <input name="name" type="text" placeholder=" " autocomplete="name" required />
                  <span class="field__label">Your Name</span>
                </label>
                <label class="field">
                  <input name="email" type="email" placeholder=" " autocomplete="email" required />
                  <span class="field__label">Your email</span>
                </label>
              </div>
              <div class="enquiry__row enquiry__row--2">
                <label class="field">
                  <input name="phone" type="tel" placeholder=" " autocomplete="tel" />
                  <span class="field__label">Your phone number</span>
                </label>
                <label class="field">
                  <input name="company" type="text" placeholder=" " autocomplete="organization" />
                  <span class="field__label">Your Company name</span>
                </label>
              </div>
              <fieldset class="picks picks--sponsorship" data-required-group data-required-message="Please choose at least one type of sponsorship.">
                <legend class="picks__legend">Type of sponsorship enquiry:</legend>
                <div class="picks__grid">
                  {
                    sponsorshipTypes.map((t) => (
                      <label class:list={['pick', { 'pick--wide': t.wide }]}>
                        <input type="checkbox" name="sponsorship_type" value={t.value} />
                        <Image
                          src={t.image}
                          alt=""
                          widths={t.wide ? [960, 1920] : [480, 960]}
                          sizes={t.wide ? '(max-width: 899px) 90vw, 880px' : '(max-width: 899px) 45vw, 440px'}
                          loading="lazy"
                          style={t.position ? `object-position: ${t.position}` : undefined}
                        />
                        <span class="pick__label display">{t.label}</span>
                        <span class="pick__tick" aria-hidden="true" />
                      </label>
                    ))
                  }
                </div>
              </fieldset>
            </>
          )
        }

        {
          variant === 'contact' && (
            <>
              <div class="enquiry__row enquiry__row--3">
                <label class="field field--select">
                  <select name="title" autocomplete="honorific-prefix" aria-label="Title">
                    <option value="" selected>Title</option>
                    {titles.map((t) => <option value={t}>{t}</option>)}
                  </select>
                </label>
                <label class="field">
                  <input name="first_name" type="text" placeholder=" " autocomplete="given-name" required />
                  <span class="field__label">First Name</span>
                </label>
                <label class="field">
                  <input name="surname" type="text" placeholder=" " autocomplete="family-name" required />
                  <span class="field__label">Surname</span>
                </label>
              </div>
              <div class="enquiry__row enquiry__row--2">
                <label class="field">
                  <input name="email" type="email" placeholder=" " autocomplete="email" required />
                  <span class="field__label">Email Address</span>
                </label>
                <label class="field">
                  <input name="phone" type="tel" placeholder=" " autocomplete="tel" required />
                  <span class="field__label">Contact Number</span>
                </label>
              </div>
              <label class="field">
                <input name="company" type="text" placeholder=" " autocomplete="organization" />
                <span class="field__label">Company Name</span>
              </label>
              <label class="field field--textarea">
                <textarea name="message" rows="3" placeholder=" "></textarea>
                <span class="field__label">Message</span>
              </label>
            </>
          )
        }

        <div class="enquiry__captcha" data-captcha></div>

        <p class="enquiry__error" role="alert" data-error hidden></p>

        <button class="btn btn--gold enquiry__submit" type="submit">Submit</button>

        <p class="enquiry__privacy">
          We'll only use your details to respond to your enquiry and communicate for future events and promotions. See our <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/privacy-policy/`}>privacy policy</a>.
        </p>
      </form>
    </div>

    <div class="modal__view modal__view--thanks" data-view="thanks" hidden>
      <h2 class="display display--md modal__title" tabindex="-1" data-thanks-title>Thank you.</h2>
      <button class="modal__close-text" type="button" data-close>Close</button>
    </div>
  </div>
</dialog>

<style>
  /*
   * On laptops and desktops the pop-up scales down to fit the screen height: the script sets
   * --fit (0.5 to 1) after measuring, and every size inside is based on this --u. The shared
   * size variables are re-declared here so they use the scaled --u too.
   */
  .modal {
    --u: calc(min(var(--max-vw) / 1728, 100vw / 1728) * var(--fit, 1));
    --text-body: max(15px, calc(24 * var(--u) * var(--type-scale)));
    --btn-height: max(40px, calc(58 * var(--u)));
    --field-height: max(48px, calc(66 * var(--u)));
    color-scheme: dark;
    font-size: var(--text-body);
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: clamp(8px, 1.2vh, 16px);
    border: 0;
    color: var(--white);
    overflow-y: auto;
    /*
     * Opened with show(), not showModal() (see openModal), so it covers the page itself: fixed,
     * full screen, with the darkened, blurred page showing through as the backdrop.
     */
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.72);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  .modal[open] {
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .modal__panel {
    position: relative;
    width: min(100%, calc(1084 * var(--u)));
    min-width: min(100%, 720px);
    margin: auto 0;
    padding: max(20px, calc(44 * var(--u))) max(24px, calc(50 * var(--u))) max(20px, calc(44 * var(--u)));
    border-radius: max(20px, calc(34 * var(--u)));
    background: var(--black);
  }

  .modal__x {
    position: absolute;
    top: max(20px, calc(42 * var(--u)));
    right: max(20px, calc(33 * var(--u)));
    padding: 4px 8px;
    border: 0;
    background: none;
    font-size: var(--text-body);
    line-height: 1;
    cursor: pointer;
  }

  .modal__title {
    margin-top: calc(14 * var(--u));
  }

  .modal__title--first {
    margin-top: 0;
    /* keep the heading clear of the X button */
    padding-right: 40px;
  }

  .modal__intro {
    margin-top: max(12px, calc(28 * var(--u)));
  }

  .modal__intro + .modal__intro {
    margin-top: 0.75em;
  }

  .modal__view--thanks {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: max(320px, calc(560 * var(--u)));
    text-align: center;
  }

  .modal__view--thanks[hidden],
  .modal__view[hidden] {
    display: none;
  }

  .modal__view--thanks .modal__title:focus {
    outline: none;
  }

  .modal__close-text {
    margin-top: max(40px, calc(80 * var(--u)));
    padding: 8px 16px;
    border: 0;
    background: none;
    font-size: var(--text-body);
    cursor: pointer;
  }

  .modal__close-text:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ---------- Form ---------- */

  .enquiry {
    display: grid;
    gap: max(12px, calc(22 * var(--u)));
    margin-top: max(18px, calc(36 * var(--u)));
  }

  .enquiry__row {
    display: grid;
    gap: max(12px, calc(22 * var(--u)));
  }

  .enquiry__row--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .enquiry__row--2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .field--span {
    grid-column: 1 / -1;
  }

  /*
   * Fields: transparent, with a fine rounded outline (same corners as the buttons) that turns gold
   * on focus. The label sits inside the field and moves up to the top edge (smaller, gold) once the
   * field has focus or a value, so it stays visible while typing.
   */
  .field {
    position: relative;
    display: block;
    --line: rgba(255, 255, 255, 0.5);
    --label-rest: rgba(255, 255, 255, 0.72);
    --pad-x: max(14px, calc(20 * var(--u)));
    --pad-top: max(17px, calc(24 * var(--u)));
  }

  .field input,
  .field select,
  .field textarea {
    display: block;
    width: 100%;
    height: var(--field-height);
    padding: var(--pad-top) var(--pad-x) max(4px, calc(6 * var(--u)));
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--white);
    font-size: var(--text-body);
    line-height: 1.3;
    text-align: left;
    appearance: none;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    border-color: rgba(255, 255, 255, 0.8);
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 1px var(--gold);
  }

  /* Browser autofill: keep the dark background and white text. */
  .field input:-webkit-autofill {
    -webkit-text-fill-color: var(--white);
    box-shadow: 0 0 0 1000px var(--black) inset;
    caret-color: var(--white);
  }

  .field input:-webkit-autofill:focus {
    box-shadow:
      0 0 0 1000px var(--black) inset,
      0 0 0 1px var(--gold);
  }

  .field__label {
    position: absolute;
    left: calc(var(--pad-x) + 1px);
    top: 50%;
    color: var(--label-rest);
    font-size: var(--text-body);
    line-height: 1.3;
    pointer-events: none;
    transform: translateY(-50%);
    transform-origin: left top;
    transition:
      top 0.2s ease,
      transform 0.2s ease,
      color 0.2s ease;
  }

  .field input:focus + .field__label,
  .field input:not(:placeholder-shown) + .field__label,
  .field textarea:focus + .field__label,
  .field textarea:not(:placeholder-shown) + .field__label,
  .field input:-webkit-autofill + .field__label {
    top: max(6px, calc(8 * var(--u)));
    color: var(--gold);
    transform: translateY(0) scale(0.62);
  }

  /* Dropdowns: the first option ("Title") is the label; a gold caret on the right. */
  .field--select select {
    padding-top: 0;
    padding-bottom: 0;
    padding-right: calc(var(--pad-x) + 22px);
    cursor: pointer;
  }

  .field--select select:has(option[value='']:checked) {
    color: var(--label-rest);
  }

  .field--select select option {
    background: var(--black);
    color: var(--white);
  }

  .field--select::after {
    content: '';
    position: absolute;
    right: calc(var(--pad-x) + 2px);
    top: 50%;
    width: 8px;
    height: 8px;
    border: solid var(--gold);
    border-width: 0 1.5px 1.5px 0;
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  /* Message box: the label rests on the first line rather than in the middle. */
  .field--textarea textarea {
    height: auto;
    min-height: calc(var(--pad-top) + 3 * 1.3em + 12px);
    resize: vertical;
  }

  .field--textarea .field__label {
    top: calc(var(--pad-top) + 1px);
    transform: none;
  }

  .field [aria-invalid='true'] {
    border-color: #ff8a80;
    box-shadow: 0 0 0 1px #ff8a80;
  }

  .field [aria-invalid='true'] + .field__label {
    color: #ff8a80;
  }

  /*
   * ---------- Picture buttons (table type, sponsorship type) ----------
   * From the "dgd - matt" form mockups: a photo with a dark fade at the bottom and the name in
   * the display font. Chosen: gold outline, gold name and a tick in the corner. Table tiles also
   * have a white outline when not chosen, as in the mockup.
   */

  .picks {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .picks__legend {
    padding: 0;
    margin-bottom: max(10px, calc(14 * var(--u)));
    color: rgba(255, 255, 255, 0.72);
  }

  .picks__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: max(12px, calc(22 * var(--u)));
  }

  /* Heights (rather than aspect ratios) so the tiles shrink with the rest of the pop-up when it scales to fit. */
  .pick {
    --pick-line: transparent;
    position: relative;
    display: block;
    height: max(72px, calc(236 * var(--u)));
    overflow: hidden;
    isolation: isolate;
    background: #111;
    cursor: pointer;
  }

  .picks--tables .pick {
    --pick-line: var(--white);
    height: max(90px, calc(302 * var(--u)));
  }

  .pick--wide {
    grid-column: 1 / -1;
    height: max(48px, calc(104 * var(--u)));
  }

  /* The radio / checkbox itself is hidden; the whole tile is its label. */
  .pick input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .pick :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .pick:hover :global(img) {
    transform: scale(1.04);
  }

  /* Dark fade behind the name, then the outline on top. */
  .pick::before,
  .pick::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .pick::before {
    z-index: 1;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 50%, #000 100%);
  }

  .picks--tables .pick::before {
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 44.5%, #000 81.4%);
  }

  .pick--wide::before {
    background: linear-gradient(to right, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.2) 70%);
  }

  .pick::after {
    z-index: 3;
    border: max(2px, calc(3 * var(--u))) solid var(--pick-line);
    transition: border-color 0.2s ease;
  }

  .pick__label {
    position: absolute;
    z-index: 2;
    left: calc(35 * var(--u));
    right: calc(20 * var(--u));
    bottom: calc(24 * var(--u));
    font-size: calc(max(24px, calc(62 * var(--u))) * var(--type-scale));
    color: var(--white);
    transition: color 0.2s ease;
  }

  .picks--tables .pick__label {
    bottom: calc(36 * var(--u));
    font-size: calc(max(26px, calc(67 * var(--u))) * var(--type-scale));
  }

  /* The table's price, in plain text under its name. It stays white when the table is chosen. */
  .pick__price {
    display: block;
    margin-top: calc(10 * var(--u));
    font-family: var(--font-sans);
    font-size: max(14px, calc(24 * var(--u) * var(--type-scale)));
    font-weight: 400;
    line-height: 1.2;
    text-transform: none;
    color: var(--white);
  }

  .pick--wide .pick__label {
    top: 50%;
    bottom: auto;
    transform: translateY(-50%);
  }

  .pick__tick {
    position: absolute;
    z-index: 4;
    top: max(8px, calc(14 * var(--u)));
    right: max(8px, calc(14 * var(--u)));
    width: max(22px, calc(30 * var(--u)));
    height: max(22px, calc(30 * var(--u)));
    border-radius: 50%;
    background: var(--gold);
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .pick__tick::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 46%;
    width: 28%;
    height: 50%;
    border: solid var(--black);
    border-width: 0 2px 2px 0;
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .picks .pick:has(input:checked) {
    --pick-line: var(--gold);
  }

  .pick:has(input:checked) .pick__label {
    color: var(--gold);
  }

  .pick:has(input:checked) .pick__tick {
    opacity: 1;
    transform: none;
  }

  .pick:has(input:focus-visible) {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }

  .picks[aria-invalid='true'] .pick {
    --pick-line: #ff8a80;
  }

  .picks[aria-invalid='true'] .picks__legend {
    color: #ff8a80;
  }

  @media (prefers-reduced-motion: reduce) {
    .pick:hover :global(img) {
      transform: none;
    }
  }

  .enquiry__captcha:empty {
    display: none;
  }

  .enquiry__error {
    color: #ff8a80;
  }

  .enquiry__submit {
    width: 100%;
  }

  .enquiry__submit[disabled] {
    opacity: 0.7;
    cursor: progress;
  }

  .enquiry__privacy {
    margin-top: calc(-6 * var(--u));
    font-size: max(13px, calc(16 * var(--u) * var(--type-scale)));
    color: rgba(255, 255, 255, 0.72);
    text-align: center;
  }

  @media (max-width: 899px) {
    .modal {
      --fit: 1;
      /* 16px or more stops iPhones zooming in when a field is tapped. */
      --text-body: 16px;
      padding: 0;
    }

    .modal__panel {
      min-width: 0;
      width: 100%;
      min-height: 100%;
      margin: 0;
      padding: 64px 20px 40px;
      border-radius: 0;
    }

    .modal__x {
      top: 20px;
      right: 16px;
      font-size: 22px;
    }

    .modal__title {
      font-size: calc(44px * var(--type-scale));
    }

    .enquiry__row--3,
    .enquiry__row--2 {
      grid-template-columns: 1fr;
    }

    .picks__grid {
      gap: 10px;
    }

    .pick {
      height: 88px;
    }

    .picks--tables .pick {
      height: 112px;
    }

    .pick--wide {
      height: 60px;
    }

    .pick__label,
    .picks--tables .pick__label {
      left: 12px;
      right: 10px;
      bottom: 10px;
      font-size: calc(26px * var(--type-scale));
    }

    .pick--wide .pick__label {
      bottom: auto;
    }

    .pick__price {
      margin-top: 4px;
      font-size: 14px;
    }
  }
</style>

<script>
  // Cloudflare Turnstile: the spam check. It is drawn inside the form and adds a hidden field
  // (cf-turnstile-response) holding a one-use token, which public/api/enquiry.php checks.
  type Turnstile = {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    getResponse: (id: string) => string | undefined;
    reset: (id: string) => void;
  };

  declare global {
    interface Window {
      turnstile?: Turnstile;
      __dgdTurnstileReady?: () => void;
    }
  }

  let turnstilePromise: Promise<void> | null = null;

  const loadTurnstile = () => {
    if (window.turnstile) return Promise.resolve();
    turnstilePromise ??= new Promise<void>((resolve, reject) => {
      window.__dgdTurnstileReady = () => resolve();
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=__dgdTurnstileReady';
      script.async = true;
      script.onerror = () => {
        turnstilePromise = null; // so opening a form again retries
        reject(new Error('Turnstile failed to load'));
      };
      document.head.appendChild(script);
    });
    return turnstilePromise;
  };

  const renderCaptcha = async (form: HTMLFormElement) => {
    const slot = form.querySelector<HTMLElement>('[data-captcha]');
    if (!slot || slot.dataset.widgetId) return;
    try {
      await loadTurnstile();
      if (!window.turnstile || slot.dataset.widgetId) return;
      slot.dataset.widgetId = window.turnstile.render(slot, {
        sitekey: form.dataset.turnstileSitekey,
        theme: 'dark',
      });
    } catch {
      // Blocked or offline: submitting explains that the security check couldn't load.
    }
  };

  const lockScroll = (locked: boolean) => document.body.classList.toggle('is-locked', locked);

  /*
   * The pop-ups open with show(), not showModal(). showModal() puts a pop-up in the browser's top
   * layer, above everything else on the page, including anything a spam check adds to the page
   * itself, which would then open hidden behind the form. Instead the pop-up covers the page (see
   * .modal), and the rest of the page is made inert (not clickable, focusable or read out) while
   * it's open, as showModal() would. A spam check's own elements are left alone so they stay usable.
   */
  const isCaptcha = (el: Element) => !!el.querySelector('iframe[src*="challenges.cloudflare.com"]');
  let inerted: HTMLElement[] = [];
  const setPageInert = (dialog: HTMLElement, on: boolean) => {
    if (!on) {
      inerted.forEach((el) => (el.inert = false));
      inerted = [];
      return;
    }
    // Every sibling of the pop-up and of each element it sits in, up to <body>.
    for (let node: HTMLElement = dialog; node.parentElement; node = node.parentElement) {
      for (const sibling of Array.from(node.parentElement.children)) {
        if (sibling === node || !(sibling instanceof HTMLElement) || sibling.inert) continue;
        if (sibling.tagName === 'SCRIPT' || sibling.tagName === 'STYLE' || isCaptcha(sibling)) continue;
        sibling.inert = true;
        inerted.push(sibling);
      }
      if (node.parentElement === document.body) break;
    }
  };
  let returnFocusTo: HTMLElement | null = null;

  // Esc closes the open pop-up (showModal() did this by itself).
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = document.querySelector<HTMLDialogElement>('dialog.modal[open]');
    if (open) {
      event.preventDefault();
      open.close();
    }
  });

  const showView = (dialog: HTMLDialogElement, view: 'form' | 'thanks') => {
    dialog.querySelectorAll<HTMLElement>('[data-view]').forEach((el) => {
      el.hidden = el.dataset.view !== view;
    });
  };

  const clearErrors = (form: HTMLFormElement) => {
    form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    const error = form.querySelector<HTMLElement>('[data-error]');
    if (error) {
      error.hidden = true;
      error.textContent = '';
    }
  };

  const showError = (form: HTMLFormElement, message: string) => {
    const error = form.querySelector<HTMLElement>('[data-error]');
    if (error) {
      error.textContent = message;
      error.hidden = false;
    }
  };

  /**
   * Scale an open pop-up down (to no less than 50%) so it fits the screen height on laptops and
   * desktops. Sizes have minimums, so it measures, adjusts and re-measures until it settles.
   * Phones (under 900px) keep the full-size layout and scroll instead.
   */
  const MIN_FIT = 0.5;
  const fitToScreen = (dialog: HTMLDialogElement) => {
    const panel = dialog.querySelector<HTMLElement>('.modal__panel');
    if (!panel || !dialog.open) return;
    if (window.innerWidth < 900) {
      dialog.style.removeProperty('--fit');
      return;
    }
    const padding = parseFloat(getComputedStyle(dialog).paddingTop) * 2;
    const available = window.innerHeight - padding;
    let fit = parseFloat(dialog.style.getPropertyValue('--fit')) || 1;
    for (let i = 0; i < 6; i++) {
      const next = Math.min(1, Math.max(MIN_FIT, (fit * available) / panel.offsetHeight));
      if (Math.abs(next - fit) < 0.004) break;
      fit = next;
      dialog.style.setProperty('--fit', fit.toFixed(4));
    }
    // Sizes have minimums, so the last step can still be a few pixels over: nudge until it fits.
    while (panel.offsetHeight > available && fit > MIN_FIT) {
      fit = Math.max(MIN_FIT, fit - 0.01);
      dialog.style.setProperty('--fit', fit.toFixed(4));
    }
  };

  const fitObserver = new ResizeObserver((entries) => {
    entries.forEach((entry) => {
      const dialog = (entry.target as HTMLElement).closest('dialog');
      if (dialog) requestAnimationFrame(() => fitToScreen(dialog));
    });
  });
  window.addEventListener('resize', () => {
    document.querySelectorAll<HTMLDialogElement>('dialog.modal[open]').forEach((d) => {
      d.style.removeProperty('--fit');
      fitToScreen(d);
    });
  });

  type Preset = { table?: string; sponsorship?: string[] };

  const openModal = (id: string, preset: Preset = {}) => {
    const dialog = document.getElementById(id) as HTMLDialogElement | null;
    const form = dialog?.querySelector('form');
    if (!dialog || !form) return;

    showView(dialog, 'form');
    clearErrors(form);

    // Pre-select from the button that opened the form.
    if (preset.table !== undefined) {
      form.querySelectorAll<HTMLInputElement>('input[name="table_type"]').forEach((radio) => {
        radio.checked = radio.value === preset.table;
      });
    }
    if (preset.sponsorship) {
      form.querySelectorAll<HTMLInputElement>('input[name="sponsorship_type"]').forEach((box) => {
        box.checked = preset.sponsorship!.includes(box.value);
      });
    }

    returnFocusTo = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    dialog.show();
    setPageInert(dialog, true);
    dialog.querySelector<HTMLElement>('.modal__x')?.focus();
    dialog.style.removeProperty('--fit');
    fitToScreen(dialog);
    lockScroll(true);
    renderCaptcha(form);
  };

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    const booking = target.closest<HTMLElement>('[data-open-booking]');
    if (booking) {
      event.preventDefault();
      openModal('booking-modal', { table: booking.dataset.openBooking ?? '' });
      return;
    }

    const sponsorship = target.closest<HTMLElement>('[data-open-sponsorship]');
    if (sponsorship) {
      event.preventDefault();
      const types = (sponsorship.dataset.openSponsorship ?? '').split(',').map((t) => t.trim()).filter(Boolean);
      openModal('sponsorship-modal', { sponsorship: types });
      return;
    }

    if (target.closest('[data-open-contact]')) {
      event.preventDefault();
      openModal('contact-modal');
    }
  });

  document.querySelectorAll<HTMLDialogElement>('dialog.modal').forEach((dialog) => {
    const form = dialog.querySelector('form');
    if (!form) return;

    // Re-fit when the content changes height (spam check appearing, error messages, thank-you view).
    dialog.querySelectorAll('[data-view]').forEach((view) => fitObserver.observe(view));

    dialog.addEventListener('close', () => {
      lockScroll(false);
      setPageInert(dialog, false);
      returnFocusTo?.focus();
      returnFocusTo = null;
    });

    // Close on backdrop click.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.querySelectorAll('[data-close]').forEach((btn) => btn.addEventListener('click', () => dialog.close()));

    const group = form.querySelector<HTMLElement>('[data-required-group]');
    const groupChecked = () => !group || !!group.querySelector('input:checked');

    form.addEventListener('change', (event) => {
      const el = event.target as HTMLInputElement;
      if (el.getAttribute('aria-invalid') === 'true' && el.checkValidity?.()) el.removeAttribute('aria-invalid');
      if (group && groupChecked()) group.removeAttribute('aria-invalid');
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors(form);

      // Validate required fields, plus the table type or sponsorship type picture buttons.
      const invalid = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[required], select[required]')).filter(
        (field) => !field.checkValidity(),
      );
      invalid.forEach((field) => field.setAttribute('aria-invalid', 'true'));

      const groupMissing = !groupChecked();
      if (groupMissing) group!.setAttribute('aria-invalid', 'true');

      if (invalid.length || groupMissing) {
        const messages: string[] = [];
        if (invalid.length) messages.push('Please fill in the highlighted fields.');
        if (groupMissing) messages.push(group!.dataset.requiredMessage ?? 'Please make a choice.');
        showError(form, messages.join(' '));
        (invalid[0] ?? group?.querySelector('input'))?.focus();
        return;
      }

      const slot = form.querySelector<HTMLElement>('[data-captcha]');
      const widgetId = slot?.dataset.widgetId;
      if (!window.turnstile || !widgetId) {
        void renderCaptcha(form); // try again, in case it was only slow
        showError(form, "The security check couldn't load. Please check your connection, switch off any content blocker for this site, and try again.");
        return;
      }
      if (!window.turnstile.getResponse(widgetId)) {
        showError(form, 'Please wait for the security check above to finish, then submit again.');
        return;
      }

      // The ticked sponsorship types are sent as one field ("Headline, Supporting").
      const data = new FormData(form);
      const types = data.getAll('sponsorship_type').map(String);
      if (types.length) data.set('sponsorship_type', types.join(', '));

      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const submitLabel = submit?.textContent ?? 'Submit';
      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const result: { success?: boolean; code?: string; message?: string; fields?: string[] } = await response.json().catch(() => ({}));
        if (!response.ok || !result.success) {
          // Problems the visitor can fix come back with a message to show; anything else is logged.
          if (result.code === 'invalid' || result.code === 'captcha' || result.code === 'limit') {
            (result.fields ?? []).forEach((name) =>
              form.querySelectorAll(`[name="${name}"]`).forEach((field) => field.setAttribute('aria-invalid', 'true')),
            );
            showError(form, result.message ?? "Sorry, your enquiry couldn't be sent. Please try again in a moment.");
            return;
          }
          throw new Error(result.message || `HTTP ${response.status}`);
        }

        form.reset();
        showView(dialog, 'thanks');
        dialog.querySelector<HTMLElement>('[data-thanks-title]')?.focus();
      } catch (error) {
        console.error('Enquiry failed', error);
        showError(form, "Sorry, your enquiry couldn't be sent. Please try again in a moment.");
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = submitLabel;
        }
        // A token only works once, so get a fresh one whether or not the enquiry went through.
        window.turnstile?.reset(widgetId);
      }
    });
  });
</script>
