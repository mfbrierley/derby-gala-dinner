---
import { Image } from 'astro:assets';
import placeholder from '../assets/images/map-placeholder.jpg';
import { VENUE } from '../config';

/**
 * Live Google map of the venue. Google sets cookies, so the iframe is only added after the
 * visitor accepts cookies (here or in the cookie banner). Until then, the map picture from
 * the Figma is shown with an accept button and a plain link to Google Maps.
 */
const query = `${VENUE.name}, ${VENUE.address}`;
const embedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(query)}&z=16&output=embed`;
const mapsLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
---

<div class="map" data-map data-embed={embedUrl} data-title={`Map showing ${query}`}>
  <Image
    class="map__placeholder"
    src={placeholder}
    alt=""
    widths={[600, 900, 1484]}
    sizes="(max-width: 899px) 100vw, 43vw"
    loading="lazy"
  />
  <div class="map__consent" data-map-consent>
    <p>The live map is provided by Google, which sets cookies.</p>
    <div class="map__actions">
      <button type="button" class="btn btn--gold" data-map-accept>Accept cookies and show map</button>
      <a class="btn btn--cream" href={mapsLink} target="_blank" rel="noopener">Open in Google Maps</a>
    </div>
  </div>
</div>

<style>
  .map {
    position: relative;
    width: calc(742 * var(--u));
    height: calc(453 * var(--u));
    overflow: hidden;
    background: #1a1a1a;
  }

  .map :global(.map__placeholder),
  .map :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map :global(.map__placeholder) {
    object-fit: cover;
  }

  .map__consent {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 24px;
    background: rgba(8, 8, 8, 0.72);
    text-align: center;
  }

  .map__consent[hidden] {
    display: none;
  }

  .map__consent p {
    font-size: max(15px, calc(20 * var(--u)));
  }

  .map__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .map__actions .btn {
    width: auto;
    min-width: 0;
    height: 48px;
    padding: 0 22px;
    font-size: max(15px, calc(20 * var(--u)));
  }

  @media (max-width: 899px) {
    .map {
      width: 100%;
      height: auto;
      aspect-ratio: 742 / 453;
      min-height: 300px;
    }
  }
</style>

<script>
  import { getConsent, setConsent, CONSENT_EVENT, type Consent } from '../scripts/consent';

  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    const overlay = map.querySelector<HTMLElement>('[data-map-consent]');

    const show = () => {
      if (map.querySelector('iframe')) return;
      const iframe = document.createElement('iframe');
      iframe.src = map.dataset.embed ?? '';
      iframe.title = map.dataset.title ?? 'Map';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.allowFullscreen = true;
      map.append(iframe);
      if (overlay) overlay.hidden = true;
    };

    const hide = () => {
      map.querySelector('iframe')?.remove();
      if (overlay) overlay.hidden = false;
    };

    if (getConsent() === 'accepted') show();

    map.querySelector('[data-map-accept]')?.addEventListener('click', () => setConsent('accepted'));

    document.addEventListener(CONSENT_EVENT, (event) => {
      if ((event as CustomEvent<Consent>).detail === 'accepted') show();
      else hide();
    });
  });
</script>
