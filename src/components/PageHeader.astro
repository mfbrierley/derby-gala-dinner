---
/** Gold band with the big page title, used at the top of every inner page in the Figma. */
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="page-header bg-gold">
  <h1 class="display display--xl page-header__title container">{title}</h1>
</section>

<style>
  .page-header {
    padding: calc(216 * var(--u)) 0 calc(16 * var(--u));
  }

  /* 185px at the Figma width (the design has 200px): a little smaller so longer titles such as
     "Your hosts for the evening" fit on one line. Used for every inner page's title. */
  .page-header__title {
    font-size: max(56px, calc(185 * var(--u)));
    color: var(--ink);
  }

  @media (max-width: 899px) {
    .page-header {
      padding: 120px 0 20px;
    }

    .page-header__title {
      font-size: 66px;
    }
  }
</style>
