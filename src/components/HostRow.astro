---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import goldLine from '../assets/svg/gold-line.svg?url';
import stripes from '../assets/svg/host-stripes.svg?url';

/**
 * One host / guest / band row: photo on the left (with the gold stripes backdrop and
 * gold underline from the Figma), label + name + subtitle on the right.
 * Nothing in the photo box has a hard cropped edge except along the gold line: the stripes fade
 * out to black on every side, and a photo that is cropped at its sides can fade there too.
 * Media geometry comes from the Figma frame and is expressed as percentages of the
 * 546px-wide media box so it scales on smaller screens.
 */
interface Props {
  label: string;
  name: string;
  subtitle: string;
  image: ImageMetadata;
  alt: string;
  /** Figma media box height in px (width is always 546). */
  boxHeight: number;
  /**
   * Photo placement inside the 546px media box, in Figma px. Set so the visible part of the photo
   * ends at the right-hand end of the gold line (546), keeping the gap to the text the same.
   */
  imgLeft: number;
  imgWidth: number;
  /** Show the stripes backdrop behind a cut-out photo. */
  backdrop?: boolean;
  /** Mirror the photo horizontally (the band photo is flipped in the Figma). */
  flip?: boolean;
  objectPosition?: string;
  /**
   * Fade the photo's cropped side edges into the black: how far in from each side of the visible
   * photo the fade runs, as a fraction of its width (0.1 = a tenth). For photos that are a
   * rectangle cut off at the sides rather than a cut-out. `[left, right]` as seen on the page.
   */
  edgeFade?: [number, number];
  /**
   * `summary` (home page): text centred against the photo.
   * `detail` (Your hosts page): text starts `textOffset` px below the top of the photo, sits
   * closer to it, and the bio (slot) follows underneath.
   */
  variant?: 'summary' | 'detail';
  textOffset?: number;
  /** Heading level for the name: 3 on the home page (under a section h2), 2 on Your hosts. */
  headingLevel?: 2 | 3;
}

const {
  label,
  name,
  subtitle,
  image,
  alt,
  boxHeight,
  imgLeft,
  imgWidth,
  backdrop = true,
  flip = false,
  objectPosition = 'center',
  edgeFade,
  variant = 'summary',
  textOffset = 47,
  headingLevel = 3,
} = Astro.props;

const Heading = headingLevel === 2 ? ("h2" as const) : ("h3" as const);

const hasBio = Astro.slots.has('default');

const W = 546;
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const mediaStyle = [
  `--box-h: ${boxHeight}`,
  `--img-left: ${pct(imgLeft, W)}`,
  `--img-w: ${pct(imgWidth, W)}`,
  `--backdrop-h: ${pct(510, boxHeight)}`,
  `--object-position: ${objectPosition}`,
].join('; ');

/*
 * The fade is a mask on the <img>. The visible photo runs from imgLeft to the end of the gold
 * line (546), which isn't the whole <img> box when the file has empty space at its sides, so
 * the stops are worked out as percentages of the box. A mirrored photo is masked before it is
 * mirrored, so its stops are mirrored too.
 */
let imgMask: string | undefined;
if (edgeFade) {
  const [fadeLeft, fadeRight] = edgeFade;
  const visible = W - imgLeft;
  const at = (px: number) => `${((flip ? imgWidth - px : px) / imgWidth * 100).toFixed(2)}%`;
  const stops = [
    `transparent ${at(0)}`,
    `#000 ${at(visible * fadeLeft)}`,
    `#000 ${at(visible * (1 - fadeRight))}`,
    `transparent ${at(visible)}`,
  ];
  imgMask = `linear-gradient(to right, ${(flip ? stops.reverse() : stops).join(', ')})`;
}
---

<div class:list={['host', `host--${variant}`]} style={`--text-offset: ${textOffset}`}>
  <div class="host__media" style={mediaStyle}>
    {backdrop && <img class="host__backdrop" src={stripes} width="500" height="510" alt="" loading="lazy" />}
    <Image
      class:list={['host__img', { 'host__img--flip': flip }]}
      src={image}
      alt={alt}
      widths={[480, 720, 1000]}
      sizes="(max-width: 899px) 90vw, 40vw"
      loading="lazy"
      style={imgMask && `-webkit-mask-image: ${imgMask}; mask-image: ${imgMask}`}
    />
    <img class="host__line" src={goldLine} width="546" height="4" alt="" />
  </div>
  <div class="host__text">
    <p class="host__label">{label}</p>
    <Heading class="display display--xl host__name">{name}</Heading>
    <p class="host__subtitle">{subtitle}</p>
    {
      hasBio && (
        <div class="host__bio">
          <slot />
        </div>
      )
    }
  </div>
</div>

<style>
  /*
   * The same gap between photo and text on every row, home page and Your hosts alike. Each photo
   * is placed so the visible part of it ends exactly where its gold line ends (see the page's
   * imgLeft / imgWidth), so this gap is the real space between photo and text.
   */
  .host {
    display: grid;
    grid-template-columns: calc(546 * var(--u)) 1fr;
    column-gap: calc(96 * var(--u));
    align-items: center;
  }

  .host--detail {
    align-items: start;
  }

  .host--detail .host__text {
    padding-top: calc(var(--text-offset) * var(--u));
  }

  .host__bio {
    max-width: calc(796 * var(--u));
    margin: calc(60 * var(--u)) 0 0 calc(11 * var(--u));
  }

  .host__media {
    position: relative;
    width: calc(546 * var(--u));
    height: calc(var(--box-h) * var(--u));
  }

  /*
   * The stripes (host-stripes.svg): 500 x 510 in the Figma's px, sitting on the gold line and
   * starting 30 to its left. They are brightest behind the photo and fade to nothing well inside
   * the image on every side, so they melt into the black with no cropped edge.
   */
  .host__backdrop {
    position: absolute;
    left: -5.495%;
    bottom: 0;
    width: 91.575%;
    max-width: none;
    height: var(--backdrop-h);
  }

  /*
   * The stripes rise above shorter photos, towards the row above. Photos, gold lines and text
   * are all lifted one level, so stripes always sit behind every row's content, never over it.
   */
  .host__media :global(.host__img),
  .host__line,
  .host__text {
    z-index: 1;
  }

  .host__media :global(.host__img) {
    position: absolute;
    left: var(--img-left);
    bottom: 0;
    width: var(--img-w);
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: var(--object-position);
  }

  .host__media :global(.host__img--flip) {
    transform: scaleX(-1);
  }

  .host__line {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 4px;
    transform: translateY(50%);
  }

  .host__text {
    position: relative;
    padding-top: calc(30 * var(--u));
    max-width: calc(866 * var(--u));
  }

  .host__label,
  .host__subtitle {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: calc(max(20px, calc(36 * var(--u))) * var(--type-scale));
    line-height: 1.31;
    color: var(--gold);
  }

  .host__name {
    margin-top: calc(5 * var(--u));
    color: var(--white);
  }

  .host__subtitle {
    margin-top: calc(-6 * var(--u));
  }

  @media (max-width: 899px) {
    .host {
      grid-template-columns: 1fr;
      row-gap: 24px;
    }

    .host__media {
      width: min(100%, 420px);
      height: auto;
      aspect-ratio: 546 / var(--box-h);
      overflow-x: clip;
    }

    /* the box clips at its sides here, so the stripes start at its edge */
    .host__backdrop {
      left: 0;
    }

    .host__text {
      padding-top: 0;
      max-width: none;
    }

    .host__name {
      margin-top: 4px;
      font-size: calc(64px * var(--type-scale));
    }

    .host__subtitle {
      margin-top: 4px;
    }

    .host--detail .host__text {
      padding-top: 0;
    }

    .host__bio {
      max-width: none;
      margin: 20px 0 0;
    }
  }
</style>
