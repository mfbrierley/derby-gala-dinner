---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import GalleryStrip from '../components/GalleryStrip.astro';

import tableEvening from '../assets/images/table-evening.jpg';
import tableVip from '../assets/images/table-vip.jpg';
import sponsorHeadline from '../assets/images/sponsor-headline.jpg';
import sponsorSupporting from '../assets/images/sponsor-supporting.jpg';
import sponsorDrinks from '../assets/images/sponsor-drinks.jpg';
import sponsorLounge from '../assets/images/sponsor-lounge.jpg';
import sponsorOther from '../assets/images/sponsor-other.jpg';

/**
 * Sponsor packages, copied from the Figma "Book a table" frame.
 * `height` is the photo tile height in the Figma; `crop` reproduces the Figma image crop
 * (image width/height and offset as % of the tile).
 */
const packages = [
  {
    id: 'headline',
    title: ['Headline Sponsor'],
    image: sponsorHeadline,
    alt: 'A Land Rover Defender on display at the 2026 gala',
    height: 550,
    crop: { w: 137.5, h: 110.68, l: -20.78, t: -5.34 },
    heading: 'From £10,000 Headline sponsorship',
    availability: '2 Headline sponsors, 1 remaining',
    includes: [
      'Premium branding on all gala promotional materials',
      'Premium evening on screen presence',
      'Host interaction with sponsor during the evening',
      'VIP table for 10 people',
      'VIP lounge access for all guests',
      'Professional group photo of your table',
      'Letter from BTG acknowledging support',
      'Use event and logos in your own promotion',
      'Customisable inclusion in event programme',
    ],
    sponsorship: 'Headline',
  },
  {
    id: 'supporting',
    title: ['supporting Sponsor'],
    image: sponsorSupporting,
    alt: 'Guests at a sponsor gin bar',
    height: 550,
    crop: { w: 124.25, h: 100.01, l: -12.05, t: -0.01 },
    heading: 'From £6,000 Supporting sponsorship',
    availability: '6 Supporting sponsors, 4 remaining',
    includes: [
      'Branding on all gala promotional materials',
      'Evening on screen presence & special host thank you announcement',
      'VIP table for 10 people',
      'VIP lounge access for all guests',
      'Professional group photo of your table',
      'Letter from BTG acknowledging support',
      'Use event and logos in your own promotion',
      'Full page advert in event programme',
    ],
    sponsorship: 'Supporting',
  },
  {
    id: 'welcome-drinks',
    title: ['Welcome drinks sponsor'],
    image: sponsorDrinks,
    alt: 'Champagne being poured into rows of glasses',
    height: 516,
    crop: { w: 116.57, h: 100.01, l: -11.6, t: -0.01 },
    heading: 'From £6,500 Welcome drink sponsor',
    availability: '1 Welcome drinks sponsor',
    includes: [
      'Inclusion and thank you in the event program',
      'Company branding inclusion at the event entry location of welcome drinks',
      'Inclusion in post event communications',
      'Sponsorship referenced on Gala website',
      'Evening table for 10 people (upgradeable)',
    ],
    sponsorship: 'Welcome drinks',
  },
  {
    id: 'vip-lounge',
    title: ['VIP lounge', 'sponsor'],
    image: sponsorLounge,
    alt: 'Guests raising a toast in the VIP lounge',
    height: 505,
    crop: { w: 148.79, h: 130.05, l: -22.36, t: -17.4 },
    heading: 'From £8,500 VIP lounge sponsor',
    availability: '1 VIP lounge sponsor',
    includes: [
      'Inclusion and thank you in the event program',
      'Sponsor branding in the lounge area (signage, coasters etc)',
      'Shared photography of the event lounge',
      'Company branding inclusion on lounge signage',
      'Inclusion in post event communications',
      'Sponsorship referenced on Gala website',
      'VIP table for 10 guests',
    ],
    sponsorship: 'VIP lounge',
    wide: true,
  },
  {
    id: 'other',
    title: ['Other', 'sponsorship'],
    image: sponsorOther,
    alt: 'Bottles of cider from a drinks sponsor',
    height: 505,
    crop: { w: 114.07, h: 100, l: -7.03, t: 0 },
    text: 'We welcome ideas of support specific to your business. Please get in touch to discuss.',
    sponsorship: 'Other',
  },
];

const cropStyle = (c: { w: number; h: number; l: number; t: number }) =>
  `width: ${c.w}%; height: ${c.h}%; left: ${c.l}%; top: ${c.t}%`;
---

<Base
  title="Book a table"
  active="tables"
  description="Book an Evening Table or VIP Table at the Derby Gala Dinner 2027, or sponsor the event in support of Bridge The Gap."
>
  <PageHeader title="Book a table" />

  <section class="tables-page bg-bars">
    <div class="container">
      <div class="lede-block">
        <h2 class="label section-label">Tables</h2>
        <p class="lede">The 2027 edition of Derby Gala Dinner promises <br />to be bigger and better than ever before.</p>
        <p class="lede-body lede-body--narrow">
          More glamorous and more entertaining. The people and businesses of Derby coming together to show a commitment to the time to
          change: Supporting a better future for our young people.
        </p>
      </div>

      <!-- Considering sponsorship? The whole box links down to the sponsor packages. -->
      <a class="sponsor-note" href="#sponsorship">
        <span class="sponsor-note__title">Considering sponsorship?</span>
        <span class="sponsor-note__text">All sponsor packages include a table for 10 guests.</span>
      </a>

      <!-- VIP Table -->
      <article class="package-card package-card--vip" id="vip-table">
        <div class="package-card__media">
          <Image
            src={tableVip}
            alt="Guests at their table at the 2026 gala dinner"
            widths={[600, 900, 1300, 1814]}
            sizes="(max-width: 899px) 100vw, 53vw"
            loading="lazy"
          />
        </div>
        <div class="package-card__body">
          <h3 class="display display--lg gold">VIP TABLE</h3>
          <div class="package-card__text">
            <p>What’s included?</p>
            <p class="package-card__gap">Evening Table package, plus;</p>
            <ul class="bullets bullets--bold">
              <li>Personalised place gift for all guests</li>
              <li>Exclusive pre-event VIP lounge</li>
              <li>Open bar access in VIP lounge</li>
              <li>Celebrity meet &amp; greet</li>
              <li>VIP table location</li>
            </ul>
            <p class="package-card__price package-card__price--tight">£3,500 + VAT</p>
          </div>
        </div>
        <a class="btn btn--gold package-card__btn" href="#vip-table" data-open-booking="VIP Table">Book a table</a>
      </article>

      <!-- Evening Table -->
      <article class="package-card package-card--evening" id="evening-table">
        <div class="package-card__media">
          <Image
            src={tableEvening}
            alt="Guests seated around their table at the 2026 gala dinner"
            widths={[600, 900, 1300, 1814]}
            sizes="(max-width: 899px) 100vw, 53vw"
            loading="lazy"
          />
        </div>
        <div class="package-card__body">
          <h3 class="display display--lg">EVENING TABLE</h3>
          <div class="package-card__text">
            <p>What’s included?</p>
            <ul class="bullets bullets--bold">
              <li>Welcome drink</li>
              <li>10 person table</li>
              <li>Place gift for all guests</li>
              <li>Premium 3 course meal</li>
              <li>Evening entertainment</li>
            </ul>
            <p class="package-card__price">£2,500 + VAT</p>
          </div>
        </div>
        <a class="btn btn--white package-card__btn" href="#evening-table" data-open-booking="Evening Table">Book a table</a>
      </article>

      <!-- Donate a seat -->
      <div class="donate" id="donate-a-seat">
        <h2 class="display display--lg donate__title"><span>Donate a place - seat or table</span></h2>
        <p class="donate__text">Would you like to donate a seat or table? Please enquire</p>
        <a class="btn btn--gold donate__btn" href="#donate-a-seat" data-open-donation>Donate now</a>
      </div>

      <!-- Sponsorship -->
      <div class="lede-block lede-block--sponsors" id="sponsorship">
        <h2 class="label section-label">Sponsors</h2>
        <p class="lede">
          Sponsors enjoy a premium position throughout every phase of the event and it is because of their involvement this
          event is able to have such an impact.
        </p>
        <p class="lede-body">
          Becoming a sponsor is a strong statement to the world that you passionately support the time to change, to improve
          the future of our young people.
        </p>
      </div>

      <h3 class="label sponsors-label">Sponsor Packages</h3>

      <ul class="sponsor-rows">
        {
          packages.map((p) => (
            <li class="sponsor-row" id={p.id}>
              <div class="sponsor-row__tile" style={`--tile-h: ${p.height}`}>
                <Image
                  class="sponsor-row__img"
                  src={p.image}
                  alt={p.alt}
                  widths={[600, 900, 1300, 1600]}
                  sizes="(max-width: 899px) 100vw, 58vw"
                  loading="lazy"
                  style={cropStyle(p.crop)}
                />
                <h4 class="display display--lg sponsor-row__title">
                  {p.title.map((line, i) => (
                    <>
                      {i > 0 && <br />}
                      {line}
                    </>
                  ))}
                </h4>
              </div>
              <div class:list={['sponsor-row__text', { 'sponsor-row__text--wide': p.wide }]}>
                {p.heading ? (
                  <>
                    <p class="sponsor-row__heading">{p.heading}</p>
                    <p class="sponsor-row__availability">{p.availability}</p>
                    <p class="sponsor-row__includes">Includes;</p>
                    <ul class="bullets">
                      {p.includes?.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <p>{p.text}</p>
                )}
                <a class="btn btn--gold sponsor-row__btn" href={`#${p.id}`} data-open-sponsorship={p.sponsorship}>
                  Secure your sponsorship now
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <GalleryStrip />
</Base>

<style>
  .tables-page {
    padding: calc(52 * var(--u)) 0 calc(103 * var(--u));
  }

  [id] {
    scroll-margin-top: 40px;
  }

  /* ---------- Intro text ---------- */

  .lede {
    max-width: calc(1337 * var(--u));
    margin-left: calc(-7 * var(--u));
    font-family: var(--font-serif);
    font-size: calc(max(24px, calc(48 * var(--u))) * var(--type-scale));
    line-height: 1.31;
    color: var(--gold);
  }

  .lede-body {
    max-width: calc(1157 * var(--u));
    margin-top: calc(28 * var(--u));
  }

  .lede-body--narrow {
    max-width: calc(1010 * var(--u));
    margin-top: calc(35 * var(--u));
  }

  .lede-block--sponsors {
    margin-top: calc(132 * var(--u));
  }

  /* ---------- "Considering sponsorship?" box ---------- */

  .sponsor-note {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: calc(74 * var(--u));
    padding: calc(28 * var(--u)) 20px calc(40 * var(--u));
    border: 3px solid var(--gold);
    background: var(--black);
    color: var(--white);
    text-align: center;
    text-decoration: none;
  }

  .sponsor-note__title {
    font-family: var(--font-serif);
    font-size: calc(max(22px, calc(44 * var(--u))) * var(--type-scale));
    line-height: 1.31;
    color: var(--gold);
  }

  .sponsor-note + .package-card {
    margin-top: calc(108 * var(--u));
  }

  /* ---------- Donate a place: heading between two fine gold lines, a line of text, a button ---------- */

  .donate {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: calc(130 * var(--u));
    text-align: center;
  }

  .donate__title {
    display: flex;
    align-items: center;
    gap: calc(42 * var(--u));
    width: 100%;
  }

  .donate__title::before,
  .donate__title::after {
    content: '';
    flex: 1;
    height: max(1px, calc(2 * var(--u)));
    background: var(--gold);
  }

  .donate__text {
    margin-top: calc(31 * var(--u));
  }

  .donate__btn {
    margin-top: calc(32 * var(--u));
  }

  /* White "Tables" / "Sponsors" headings above each lede (Figma "dgd - matt"). */
  .section-label {
    color: var(--white);
  }

  .section-label + .lede {
    margin-top: calc(14 * var(--u));
  }

  /* ---------- Bulleted lists ---------- */

  .bullets {
    padding-left: 1.5em;
    list-style: disc;
  }

  .bullets--bold {
    padding-left: calc(36 * var(--u) + 0.4em);
    font-weight: 700;
  }

  /* ---------- Evening / VIP table cards ---------- */

  .package-card {
    position: relative;
    /* Figma height, but the card grows if the text needs more room (narrow desktop widths). */
    min-height: calc(604 * var(--u));
    margin-top: calc(82 * var(--u));
    border: 3px solid var(--white);
    isolation: isolate;
  }

  /* The second card sits a little closer to the first. */
  .package-card + .package-card {
    margin-top: calc(54 * var(--u));
  }

  .package-card--vip {
    border-color: var(--gold);
  }

  .package-card__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }

  .package-card__media :global(img) {
    position: absolute;
    top: 0;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  /* Evening: photo on the right two thirds, fading to black towards the text on the left. */
  .package-card--evening .package-card__media :global(img) {
    left: 33.25%;
    width: 66.73%;
  }

  .package-card--evening::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to right, #000 41.2%, rgba(0, 0, 0, 0) 66.1%);
  }

  /* VIP: photo on the left two thirds, fading to black towards the text on the right. */
  .package-card--vip .package-card__media :global(img) {
    left: -0.74%;
    width: 66.63%;
  }

  .package-card--vip::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to right, rgba(0, 0, 0, 0) 31.7%, #000 49%);
  }

  .package-card__body {
    width: max(calc(501 * var(--u)), 260px);
    margin-left: calc(86 * var(--u));
    padding: calc(77 * var(--u)) 0 max(calc(60 * var(--u)), 44px);
  }

  .package-card--vip .package-card__body {
    margin-left: calc(737 * var(--u));
  }

  .package-card__text {
    margin-top: calc(44 * var(--u));
    max-width: max(calc(315 * var(--u)), 240px);
  }

  .package-card--vip .package-card__text {
    max-width: calc(501 * var(--u));
  }

  .package-card__text .bullets {
    margin-top: 1.31em;
  }

  .package-card__gap {
    margin-top: 1.31em;
  }

  .package-card__gap + .bullets {
    margin-top: 0;
  }

  .package-card__price {
    margin-top: 2.62em;
    font-weight: 700;
  }

  .package-card__price--tight {
    margin-top: 1.31em;
  }

  /* The button sits across the card's bottom border, as in the Figma. */
  .package-card__btn {
    position: absolute;
    left: calc(85 * var(--u));
    bottom: calc(-29 * var(--u) - 3px);
  }

  .package-card--vip .package-card__btn {
    left: calc(731 * var(--u));
  }

  /* ---------- Sponsor packages ---------- */

  .sponsors-label {
    margin-top: calc(134 * var(--u));
  }

  .sponsor-rows {
    display: grid;
    gap: calc(32 * var(--u));
    margin-top: calc(20 * var(--u));
  }

  .sponsor-row {
    display: grid;
    /* The text column runs past the content edge, as in the Figma (663–697px wide). */
    grid-template-columns: calc(664 * var(--u)) calc(697 * var(--u));
    column-gap: calc(68 * var(--u));
    align-items: center;
  }

  .sponsor-row__tile {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: calc(var(--tile-h) * var(--u));
    padding: 0 calc(42 * var(--u)) calc(30 * var(--u));
    overflow: hidden;
    isolation: isolate;
  }

  .sponsor-row__tile :global(.sponsor-row__img) {
    position: absolute;
    z-index: -2;
    max-width: none;
    object-fit: cover;
  }

  .sponsor-row__tile::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: -1;
    height: calc(330 * var(--u));
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0), #000);
  }

  .sponsor-row__title {
    max-width: calc(622 * var(--u));
  }

  .sponsor-row__text {
    max-width: calc(663 * var(--u));
  }

  .sponsor-row__text--wide {
    max-width: calc(697 * var(--u));
  }

  .sponsor-row__heading,
  .sponsor-row__availability {
    font-size: calc(max(18px, calc(28 * var(--u))) * var(--type-scale));
  }

  .sponsor-row__availability {
    font-weight: 700;
    color: var(--gold);
  }

  .sponsor-row__includes {
    margin-top: 1.31em;
  }

  .sponsor-row__btn {
    width: calc(471 * var(--u));
    min-width: 220px;
    margin-top: calc(32 * var(--u));
  }

  /* ---------- Mobile ---------- */

  @media (max-width: 899px) {
    .tables-page {
      padding: 40px 0 72px;
    }

    .lede {
      max-width: none;
      margin-left: 0;
    }

    .lede br {
      display: none;
    }

    .lede-body,
    .lede-body--narrow {
      max-width: none;
      margin-top: 16px;
    }

    .lede-block--sponsors {
      margin-top: 64px;
    }

    .sponsor-note {
      margin-top: 32px;
      padding: 20px 16px 24px;
    }

    .sponsor-note + .package-card {
      margin-top: 32px;
    }

    .donate {
      margin-top: 56px;
    }

    /* Sized to the screen so the heading stays on one line, with short gold lines either side. */
    .donate__title {
      gap: 10px;
      font-size: calc(min(48px, 8.4vw) * var(--type-scale));
    }

    .donate__title::before,
    .donate__title::after {
      min-width: 12px;
    }

    .donate__text {
      margin-top: 16px;
    }

    .donate__btn {
      margin-top: 20px;
    }

    .section-label + .lede {
      margin-top: 8px;
    }

    .package-card {
      display: flex;
      flex-direction: column;
      height: auto;
      min-height: 0;
      margin-top: 40px;
      background: #000;
    }

    .package-card + .package-card {
      margin-top: 32px;
    }

    .package-card__media {
      position: relative;
      inset: auto;
      z-index: 0;
      aspect-ratio: 3 / 2;
    }

    .package-card--evening .package-card__media :global(img),
    .package-card--vip .package-card__media :global(img) {
      left: 0;
      width: 100%;
    }

    .package-card::after {
      display: none;
    }

    .package-card__media::after {
      content: '';
      position: absolute;
      inset: 50% 0 0;
      background: linear-gradient(to bottom, rgba(0, 0, 0, 0), #000);
    }

    .package-card__body,
    .package-card--vip .package-card__body {
      position: relative;
      width: auto;
      margin-left: 0;
      margin-top: -36px;
      padding: 0 20px;
    }

    .package-card__body h3 {
      font-size: calc(56px * var(--type-scale));
    }

    .package-card__text,
    .package-card--vip .package-card__text {
      max-width: none;
      margin-top: 16px;
    }

    .package-card__price {
      margin-top: 1.31em;
    }

    .package-card__btn,
    .package-card--vip .package-card__btn {
      position: relative;
      left: auto;
      bottom: auto;
      align-self: flex-start;
      margin: 20px 20px 24px;
    }

    .sponsors-label {
      margin-top: 48px;
    }

    .sponsor-rows {
      gap: 48px;
      margin-top: 16px;
    }

    .sponsor-row {
      grid-template-columns: 1fr;
      row-gap: 20px;
    }

    .sponsor-row__tile {
      height: auto;
      aspect-ratio: 664 / var(--tile-h);
      padding: 0 20px 20px;
    }

    .sponsor-row__tile::after {
      height: 60%;
    }

    .sponsor-row__title {
      max-width: none;
      font-size: calc(52px * var(--type-scale));
    }

    .sponsor-row__text,
    .sponsor-row__text--wide {
      max-width: none;
    }

    .sponsor-row__btn {
      width: auto;
      min-width: 0;
      margin-top: 20px;
    }
  }
</style>
