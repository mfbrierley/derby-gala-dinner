---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { Image } from 'astro:assets';
import BtgSpotlight from '../components/BtgSpotlight.astro';
import GalleryStrip from '../components/GalleryStrip.astro';
import venuePhoto from '../assets/gallery/AVI00204.jpg';
import vaillantLive from '../assets/images/vaillant-live.png';
import { VENUE } from '../config';

const mapsLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${VENUE.name}, ${VENUE.address}`)}`;

// From the "dgd - matt" Figma (times written with colons throughout, as agreed with Matt).
const timings: { title: string; times: [string, string][] }[] = [
  {
    title: 'VIP Guests',
    times: [
      ['17:30', 'Doors'],
      ['17:30', 'Lounge access (Until 19:00)'],
      ['19:00', 'Main event'],
      ['00:00', 'Carriages'],
    ],
  },
  {
    title: 'Evening Guests',
    times: [
      ['18:00', 'Doors'],
      ['18:00', 'Welcome drinks (Until 19:00)'],
      ['19:00', 'Main event'],
      ['00:00', 'Carriages'],
    ],
  },
];
---

<Base
  title="Event details"
  active="details"
  description="Derby Gala Dinner 2027: 22/04/27 at Vaillant Live Derby, 2 Colyear St, Derby DE1 1LA. Timings for VIP and evening guests, and the menu."
>
  <PageHeader title="Event details" />

  <section class="details bg-bars">
    <div class="container">
      <!-- Date and Venue box (Figma "dgd - matt"): details on the left, the venue photo fading in from the right. -->
      <div class="venue">
        <div class="venue__media">
          <Image
            src={venuePhoto}
            alt="The venue laid out for the 2026 gala dinner: round tables in front of the stage"
            widths={[600, 900, 1300, 1800, 2400]}
            sizes="(max-width: 899px) 100vw, 62vw"
          />
        </div>
        <div class="venue__body">
          <h2 class="label">Date and Venue</h2>
          <p class="details__big venue__date"><time datetime="2027-04-22">22/04/27</time></p>
          <img class="venue__logo" src={vaillantLive.src} width="169" height="68" alt="Vaillant Live" />
          <p class="venue__address">{VENUE.name}, <br />{VENUE.address}</p>
          <p class="venue__map"><a href={mapsLink} target="_blank" rel="noopener">View on maps</a></p>
        </div>
      </div>

      <hr class="details__rule" />

      <h2 class="label">Timings</h2>
      <div class="details__row details__timings">
        {
          timings.map((group) => (
            <div>
              <h3 class="label gold">{group.title}</h3>
              <ul class="details__times">
                {group.times.map(([time, what]) => (
                  <li>
                    <time>{time}</time> - {what}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <hr class="details__rule" />

      <h2 class="label">Menu</h2>
      <p class="details__big details__soon">Coming soon...</p>
    </div>
  </section>

  <BtgSpotlight padTop={115} padBottom={105} />
  <GalleryStrip />
</Base>

<style>
  /*
   * Figma "dgd - matt", Event details frame. Measurements are Figma px from the top of the
   * striped section.
   */
  .details {
    --cols: calc(641 * var(--u)) calc(742 * var(--u));
    padding: calc(54 * var(--u)) 0 calc(182 * var(--u));
  }

  /*
   * Date and Venue box: 1396 x 510 with a 3px white border, starting 11 left of the text edge
   * like the gold lines below it, and stopping at the same right-hand edge as they do.
   */
  .venue {
    position: relative;
    width: calc(1396 * var(--u));
    max-width: calc(100% + 11 * var(--u));
    min-height: calc(510 * var(--u));
    margin-left: calc(-11 * var(--u));
    border: 3px solid var(--white);
    background: #000;
    isolation: isolate;
  }

  /* The photo fills the right-hand 1066 of the box (cropped as in the Figma) and fades to black towards the text. */
  .venue__media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: -1;
    width: calc(1066 * var(--u));
    max-width: 100%;
    overflow: hidden;
  }

  .venue__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 19.7%;
  }

  .venue__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0, 0, 0, 0.96) 0%, rgba(0, 0, 0, 0) 99%);
  }

  .venue__body {
    padding: calc(69 * var(--u) - 3px) calc(40 * var(--u)) calc(60 * var(--u)) calc(62 * var(--u) - 3px);
  }

  .venue__date {
    margin-top: calc(16 * var(--u));
  }

  .venue__logo {
    width: max(120px, calc(169 * var(--u)));
    height: auto;
    margin-top: calc(20 * var(--u));
  }

  .venue__address {
    margin-top: calc(27 * var(--u));
  }

  .venue__map {
    margin-top: 1.31em;
  }

  .venue__map a {
    color: var(--white);
    text-underline-offset: 3px;
  }

  .venue__map a:hover {
    color: var(--gold);
  }

  .details__row {
    display: grid;
    grid-template-columns: var(--cols);
  }

  .details__big {
    font-family: var(--font-serif);
    font-size: calc(max(24px, calc(48 * var(--u))) * var(--type-scale));
    line-height: 1.31;
    color: var(--gold);
  }

  /* Fine gold lines between the sections; they run slightly past the text edge, as in the Figma. */
  .details__rule {
    width: calc(1394 * var(--u));
    max-width: calc(100% + 11 * var(--u));
    height: max(1px, calc(2 * var(--u)));
    margin: calc(43 * var(--u)) 0 calc(42 * var(--u)) calc(-11 * var(--u));
    border: 0;
    background: var(--gold);
  }

  .details__timings {
    margin-top: calc(35 * var(--u));
  }

  .details__times {
    margin-top: calc(41 * var(--u));
  }

  .details__timings + .details__rule {
    margin-top: calc(68 * var(--u));
  }

  .details__soon {
    margin-top: calc(16 * var(--u));
  }

  @media (max-width: 899px) {
    .details {
      padding: 40px 0 72px;
    }

    /* Phones: the photo sits across the top of the box, fading down into the black; details below. */
    .venue {
      width: auto;
      max-width: none;
      min-height: 0;
      margin-left: 0;
    }

    .venue__media {
      position: relative;
      z-index: 0;
      width: 100%;
      aspect-ratio: 16 / 10;
    }

    .venue__media::after {
      background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 45%, #000 100%);
    }

    .venue__body {
      padding: 12px 20px 24px;
    }

    .venue__date {
      margin-top: 6px;
    }

    .venue__logo {
      margin-top: 12px;
    }

    .venue__address {
      margin-top: 16px;
    }

    .details__row {
      grid-template-columns: 1fr;
      row-gap: 32px;
    }

    .details__rule,
    .details__timings + .details__rule {
      width: auto;
      max-width: none;
      height: 1px;
      margin: 40px 0;
    }

    .details__timings {
      margin-top: 20px;
    }

    .details__times {
      margin-top: 10px;
    }

    .details__soon {
      margin-top: 8px;
    }
  }
</style>
