---
import '../styles/global.css';
import Header from '../components/Header.astro';
import type { NavKey } from '../types';
import Footer from '../components/Footer.astro';
import EnquiryModal from '../components/EnquiryModal.astro';
import CookieBanner from '../components/CookieBanner.astro';
import barsTop from '../assets/images/bars/bars-top-2560.webp?url';
import barsTopLarge from '../assets/images/bars/bars-top-3840.webp?url';
import barsBottom from '../assets/images/bars/bars-bottom-2560.webp?url';
import barsBottomLarge from '../assets/images/bars/bars-bottom-3840.webp?url';
import { SITE_NAME, TYPEKIT_CSS } from '../config';

interface Props {
  title?: string;
  description?: string;
  active?: NavKey;
  /** Keep this page out of search engines (e.g. the 404 page). */
  noindex?: boolean;
}

const {
  title,
  description = 'Derby Gala Dinner: a premium black tie evening of entertainment in the service of Bridge The Gap. 22/04/27, Vaillant Live Derby.',
  active = 'none',
  noindex: pageNoindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Keep Vercel previews and the IONOS test copy (npm run build:test) out of search engines;
// the live build (npm run build) is indexable.
const noindex = pageNoindex || Boolean(process.env.VERCEL) || Boolean(process.env.NOINDEX);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/*
 * Gold bars background for the black body sections: a faded band of bars along the very top and
 * the very bottom of each section, black in between. Cut from the "Bars 01" still (3840 x 2160)
 * in the 06.Backgrounds Drive folder: rows 0-600 and 1560-2160, at half strength and transparent
 * where there are no bars, saved as WebP (quality 75, transparency quality 60) in
 * src/assets/images/bars/. 2560px wide for phones and standard screens, 3840px for Retina and very
 * wide screens.
 */
const BARS_LARGE_MEDIA = '(min-width: 900px) and (min-resolution: 1.5dppx), (min-width: 900px) and (-webkit-min-device-pixel-ratio: 1.5), (min-width: 1800px)';
const BARS_STANDARD_MEDIA = '(max-width: 899px), (max-width: 1799px) and (max-resolution: 1.49dppx)';
const barsCss = `:root{--bars-top:url(${barsTop});--bars-bottom:url(${barsBottom})}@media ${BARS_LARGE_MEDIA}{:root{--bars-top:url(${barsTopLarge});--bars-bottom:url(${barsBottomLarge})}}`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!pageNoindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!pageNoindex && <meta property="og:url" content={canonical} />}
    <meta name="theme-color" content="#080808" />

    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />

    <!-- The top band shows near the top of most pages, so it's fetched early. -->
    <link rel="preload" as="image" href={barsTop} media={BARS_STANDARD_MEDIA} />
    <link rel="preload" as="image" href={barsTopLarge} media={BARS_LARGE_MEDIA} />
    <style is:inline set:html={barsCss} />

    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="stylesheet" href={TYPEKIT_CSS} />
    <script is:inline>
      // If the Adobe fonts can't load (network or subscription problem), switch to normal-sized
      // fallback fonts rather than the width-matched ones (see "Fallback fonts" in global.css).
      if (document.fonts && document.fonts.load) {
        document.fonts
          .load('700 1em "arteria-std-compress"')
          .then(function (faces) { if (!faces.length) document.documentElement.classList.add('fonts-failed'); })
          .catch(function () { document.documentElement.classList.add('fonts-failed'); });
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <EnquiryModal variant="booking" />
    <EnquiryModal variant="sponsorship" />
    <EnquiryModal variant="contact" />
    <CookieBanner />
    <script>
      // Links like /book-a-table/#sponsorship: the browser jumps to the section before the
      // Adobe fonts arrive, and the text above it changes height when they do. Re-align once loaded.
      if (location.hash.length > 1) {
        const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (target) document.fonts?.ready.then(() => target.scrollIntoView({ behavior: 'instant', block: 'start' }));
      }
    </script>
  </body>
</html>
